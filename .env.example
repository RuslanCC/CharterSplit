# ─────────────────────────────────────────────────────────────
# CharterSplit — пример конфигурации. Скопируйте в .env и заполните:
#   cp .env.example .env
# .env в git не попадает (см. .gitignore).
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=chartersplit
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=chartersplit
# Строка подключения для Prisma/backend. host = имя сервиса БД в compose (db).
DATABASE_URL=postgresql://chartersplit:change_me_strong_password@db:5432/chartersplit?schema=public

# ── Telegram ──────────────────────────────────────────────────
# Токен бота из @BotFather. Обязателен: им же проверяется подпись initData.
TELEGRAM_BOT_TOKEN=123456:REPLACE_WITH_YOUR_BOT_TOKEN
# Секрет вебхука: часть пути + заголовок X-Telegram-Bot-Api-Secret-Token.
# Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=change_me_webhook_secret
# Максимальный возраст initData (сек) при проверке авторизации.
INIT_DATA_EXPIRES_IN=3600
# Контакт для вопросов в /start и /help бота (например, @your_username).
# Пусто — строка с контактом не показывается.
SUPPORT_CONTACT=
# Telegram User ID владельцев бота через запятую: им доступна команда /admin
# со статистикой и отчётами по всем поездкам. Пусто — админ-раздел выключен.
ADMIN_TELEGRAM_IDS=

# ── Приложение ────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
# Публичный URL Mini App — тот же, что указывается в @BotFather.
# Вебхук регистрируется на ${PUBLIC_URL}/api/telegram/webhook/<секрет>.
PUBLIC_URL=https://example.com
# Под-путь, если приложение живёт не в корне домена (например, /chartersplit).
# Зашивается в бандл фронтенда при сборке. Пусто — корень домена.
NEXT_PUBLIC_BASE_PATH=

# ── Только для docker-compose.yml (за внешним reverse-proxy) ──
# Внешняя docker-сеть, к которой подключён ваш reverse-proxy.
PROXY_NETWORK=proxy

# ── Только для docker-compose.standalone.yml (свой nginx + TLS) ──
DOMAIN=example.com
LETSENCRYPT_EMAIL=you@example.com
# 1 — тестовые сертификаты Let's Encrypt (для первого запуска).
CERTBOT_STAGING=0
