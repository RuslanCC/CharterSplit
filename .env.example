# ─────────────────────────────────────────────────────────────
# CharterSplit — пример конфигурации. Скопируйте в .env и заполните.
#   cp .env.example .env
# .env в git не попадает (см. .gitignore).
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=chartersplit
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=chartersplit
# DATABASE_URL используется Prisma и backend-контейнером.
# host = имя сервиса БД в docker-compose (db), порт 5432.
DATABASE_URL=postgresql://chartersplit:change_me_strong_password@db:5432/chartersplit?schema=public

# ── Telegram ──────────────────────────────────────────────────
# Токен бота из @BotFather. НИКОГДА не коммитить.
TELEGRAM_BOT_TOKEN=123456:REPLACE_WITH_YOUR_BOT_TOKEN
# Секрет в пути вебхука + заголовок X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=change_me_webhook_secret
# Максимальный возраст initData (сек) при валидации авторизации.
INIT_DATA_EXPIRES_IN=3600

# ── Приложение ────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
# Под-путь, под которым Mini App проксируется Caddy на этом VPS.
BASE_PATH=/chartersplit
# Публичный URL Mini App (тот же, что указывается в BotFather).
PUBLIC_URL=https://vps.ruslan.cc/chartersplit

# ── Frontend (доступно в браузере, префикс NEXT_PUBLIC_) ──────
NEXT_PUBLIC_BASE_PATH=/chartersplit
NEXT_PUBLIC_APP_URL=https://vps.ruslan.cc/chartersplit

# ── Только для docker-compose.standalone.yml (свой edge) ──────
# Домен для nginx + certbot (используется, если разворачиваете на чистом сервере).
DOMAIN=example.com
LETSENCRYPT_EMAIL=you@example.com
